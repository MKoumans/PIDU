# Environment-only image: dependencies, no project code, no PYTHONPATH.
# Used to build the Apptainer image (pidu-env.sif) for Slurm clusters, where the live
# checkout is bind-mounted at runtime and must not be shadowed by a baked-in copy.
FROM python:3.13.7
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential gcc curl libpq-dev && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/
# The environment lives outside /app so that bind-mounting the checkout does not shadow it.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml uv.lock /tmp/deps/
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /tmp/deps && uv sync --frozen --no-install-project && rm -rf /tmp/deps
